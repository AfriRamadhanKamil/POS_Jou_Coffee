# Environment: development, testing, production
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=jou-coffee-dev-secret-change-in-production

# Database (MySQL 8)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
# For local dev / testing fallback: sqlite:///jou_coffee.db
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/jou_coffee?charset=utf8mb4

# Redis (Cache, Pub/Sub, SocketIO message queue)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Authentication
JWT_SECRET_KEY=jou-jwt-dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# QR Menu & Payment Gateway
QR_HMAC_SECRET=table-qr-signed-secret-change-in-prod
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_GATEWAY_SERVER_KEY=SB-Mid-server-xxxxxx
PAYMENT_GATEWAY_CLIENT_KEY=SB-Mid-client-xxxxxx
PAYMENT_GATEWAY_BASE_URL=https://api.sandbox.midtrans.com

# Device limits & Offline session
MAX_ACTIVE_DEVICES_PER_USER=3
OFFLINE_SESSION_MAX_DAYS=7

