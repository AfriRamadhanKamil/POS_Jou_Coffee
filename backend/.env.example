# Environment: development, testing, production
FLASK_ENV=development
FLASK_APP=run.py
HOST=0.0.0.0
PORT=5000
SECRET_KEY=jou-coffee-dev-secret-change-in-production

# Database (local XAMPP MariaDB; default XAMPP root password is empty)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/jou_coffee?charset=utf8mb4

# Redis (Cache, Pub/Sub, SocketIO message queue)
REDIS_URL=redis://127.0.0.1:6379/0
# Production defaults to REDIS_URL; leave unset in development for in-memory limits.
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# Optional in local development. Leave empty to run realtime in this backend process.
SOCKETIO_MESSAGE_QUEUE=
# Production must set explicit HTTPS origins, comma-separated.
# CORS_ORIGINS=https://pos.example.com,https://qr.example.com
AUTH_LOGIN_RATE_LIMIT=10 per minute
AUTH_PIN_RATE_LIMIT=5 per minute

# JWT Authentication
JWT_SECRET_KEY=jou-jwt-dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# QR Menu & Payment Gateway
QR_HMAC_SECRET=table-qr-signed-secret-change-in-prod
QR_ORDER_RATE_LIMIT=10 per minute
QR_ORDER_TABLE_RATE_LIMIT=60 per minute
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_GATEWAY_SERVER_KEY=SB-Mid-server-xxxxxx
PAYMENT_GATEWAY_CLIENT_KEY=SB-Mid-client-xxxxxx
PAYMENT_GATEWAY_BASE_URL=https://api.sandbox.midtrans.com
# Optional Firebase service-account JSON path for cashier push notifications.
FCM_SERVICE_ACCOUNT_FILE=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Device limits & Offline session
MAX_ACTIVE_DEVICES_PER_USER=3
OFFLINE_SESSION_MAX_DAYS=7
